# ---------------------------------------------------------------- data: large or downloaded inputs stay local
# ERA5 for Stage 1: monthly and hourly files (a copy of the hourly files is on Azure)
data/shared/era5/monthly/
data/shared/era5/hourly/
# C3S seasonal forecasts (scripts/00_download_inputs.py --c3s)
data/shared/c3s/
# inputs that no step of the run reads (see data/shared/archive/README.md)
data/shared/archive/
# PSA CPI full tables (the backcast is over GitHub's 100 MB limit; see data/prices/psa_cpi/README.md)
data/prices/psa_cpi/*.csv

